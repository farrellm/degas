{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests", ":semanticCommitsDisabled"],
  "schedule": ["before 6am on monday"],
  "lockFileMaintenance": { "enabled": true },
  "packageRules": [
    {
      "groupName": "dev tools",
      "matchFileNames": ["Makefile"]
    },
    {
      "groupName": "github actions",
      "matchManagers": ["github-actions"]
    },
    {
      "description": "Digest-pinned and gated by CI; majors still wait for review",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true
    },
    {
      "groupName": "web dev tools",
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"]
    },
    {
      "description": "colabkit is our own shared library; a new tag gets its own PR",
      "groupName": "python",
      "matchManagers": ["pep621"],
      "matchDepNames": ["!colabkit"]
    },
    {
      "description": "Python is pinned to the Colab runtime's version; bump it by hand",
      "matchDepNames": ["python"],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Tool versions annotated with # renovate: comments",
      "managerFilePatterns": ["/^Makefile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n[A-Z_]+\\s*:=\\s*(?<currentValue>\\S+)"
      ]
    }
  ]
}
